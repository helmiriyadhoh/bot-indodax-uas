# Salin ke .env (JANGAN di-commit). Di Vercel isi lewat Settings > Environment Variables.
CRON_SECRET=
# Dua variabel ini otomatis terisi saat Upstash Redis dihubungkan ke project Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Opsional: kill switch lewat env (nilai 1). Bisa juga lewat Redis: SET bot:kill 1
KILL_SWITCH=
# Hanya untuk skrip di laptop (scripts/unduh_log.py)
BOT_BASE_URL=https://NAMA-PROJECT.vercel.app
